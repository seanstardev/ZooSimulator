# Folder-local Apache MIME defaults; harmless when mod_mime is unavailable.
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType text/javascript .js .mjs
  AddType application/json .json
  AddType model/gltf-binary .glb
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/wasm text/javascript application/json text/css image/svg+xml
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>
